      "attacker": {
        "speed": 120
      },
      "defender": {
        "speed": 80
      },
      "ally": {
        "speed": 100
      },
      "opponent_ally": {
        "speed": 60,
        "item": "ITEM_QUICK_CLAW"
      },
      "quick_claw_draw": 13107,
